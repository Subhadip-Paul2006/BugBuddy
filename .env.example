# =====================================================================
# BugBuddy — Environment Configuration Template
# =====================================================================
# SECURITY NOTICE:
# - Never commit real API keys or secrets to version control.
# - Never prefix secret server keys with VITE_ (Vite inlines VITE_* into client bundles).
# - Server-side keys are read exclusively by the backend Node process.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Server-Side Service Configuration (Backend)
# ---------------------------------------------------------------------
# Port for the Node backend service (Render sets this automatically to 10000)
PORT=3001

# Host network interface to bind to (0.0.0.0 required for container/cloud hosting)
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated list or '*' for open access)
# In production, set to your deployed frontend URL (e.g. https://bugbuddy.onrender.com)
CORS_ORIGIN=*

# ---------------------------------------------------------------------
# 2. Server-Side AI Provider Credentials (Backend)
# ---------------------------------------------------------------------
# Default active provider ('openai' | 'gemini' | 'mock')
# Defaults to auto-detecting available keys, or 'mock' if none configured
DEFAULT_AI_PROVIDER=mock

# Google Gemini / Gemma API Key
# Format: AIzaSy...
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Gemini API Base URL (defaults to Google Generative Language API)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI API Key
# Format: sk-...
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI API Base URL (defaults to standard OpenAI endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------
# 3. Client-Side Build Configuration (Frontend Static Site)
# ---------------------------------------------------------------------
# Base URL for the deployed backend API (used when frontend and backend are hosted on separate origins)
# Example: https://bugbuddy-api.onrender.com
# Leave blank or omit when using a local dev proxy or single-origin routing
VITE_API_BASE_URL=
